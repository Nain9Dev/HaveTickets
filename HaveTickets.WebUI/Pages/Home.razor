@page "/"
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>HaveTickets | Movies</PageTitle>

<div class="header-section">
    <h1>Now Showing</h1>
    <p class="text-secondary">Get your tickets instantly for the hottest movies.</p>
</div>

@if (movies == null)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading catalog...</p>
    </div>
}
else
{
    <div class="grid-cards">
        @foreach (var movie in movies)
        {
            <div class="glass-panel movie-card">
                <img src="@movie.PosterUrl" alt="@movie.Title" class="movie-poster" />
                <div class="movie-info">
                    <span class="genre-badge">@movie.Genre</span>
                    <h3>@movie.Title</h3>
                    <p class="movie-desc">@movie.Description</p>
                    <div class="movie-meta">
                        <span>⏱️ @movie.DurationMinutes min</span>
                        <span>📅 @movie.ReleaseDate.ToString("MMM dd, yyyy")</span>
                    </div>
                    <button class="btn-primary" @onclick="() => SelectMovie(movie.Id)">Get Tickets</button>
                </div>
            </div>
        }
    </div>
}

<style>
    .header-section {
        margin-bottom: 2rem;
    }
    
    .movie-card {
        display: flex;
        flex-direction: column;
        padding: 0;
        overflow: hidden;
    }
    
    .movie-poster {
        width: 100%;
        height: 350px;
        object-fit: cover;
        border-bottom: 1px solid var(--surface-border);
    }
    
    .movie-info {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }
    
    .genre-badge {
        background: rgba(139, 92, 246, 0.2);
        color: #a78bfa;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        width: fit-content;
        margin-bottom: 0.5rem;
    }
    
    .movie-desc {
        color: var(--text-secondary);
        font-size: 0.9rem;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 1rem;
        flex-grow: 1;
    }
    
    .movie-meta {
        display: flex;
        justify-content: space-between;
        font-size: 0.85rem;
        color: #94a3b8;
        margin-bottom: 1.5rem;
    }
    
    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 40vh;
        color: var(--text-secondary);
    }
    
    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid rgba(255, 255, 255, 0.1);
        border-left-color: var(--accent-color);
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-bottom: 1rem;
    }
    
    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

@code {
    private List<MovieDto>? movies;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            movies = await Http.GetFromJsonAsync<List<MovieDto>>("api/movies");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching movies: {ex.Message}");
        }
    }

    private void SelectMovie(Guid id)
    {
        Nav.NavigateTo($"movie/{id}");
    }
}
